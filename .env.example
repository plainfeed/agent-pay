# Copy to .env.local (not committed) or export in your shell. Every setting is optional.
# With no PayPal keys the gateway runs in mock mode: a local fake of the PayPal Orders API.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox). Setting both switches to sandbox mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same sandbox app (only needed if PayPal can reach your server, for example through a tunnel).
PAYPAL_WEBHOOK_ID=

# Where buyers' browsers come back to after approving in PayPal. Must match how you reach this server.
PUBLIC_URL=http://localhost:8787
PORT=8787
HOST=127.0.0.1

# Secret used to sign receipts. If empty, one is generated and kept in .local/receipt-secret.
RECEIPT_SECRET=

# Optional: serve a live Plainfeed feed instead of the sample dataset. The key stays on the server.
UPSTREAM_URL=
UPSTREAM_API_KEY=
